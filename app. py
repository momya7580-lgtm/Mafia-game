]

def get_room(code):
    return rooms.get(code)

def public_state(code):
    room = get_room(code)
    if not room:
        return None

    return {
        "code": code,
        "phase": room["phase"],
        "round": room["round"],
        "message": room["message"],
        "deadline": room["deadline"],
        "host": room["host"],
        "players": [
            {
                "name": p["name"],
                "color": p["color"],
                "alive": p["alive"]
            }
            for p in room["players"].values()
        ]
    }

def update_room(code):
    room = get_room(code)
    if not room:
        return

    for sid in room["players"]:
        data = public_state(code)
        data["is_host"] = sid == room["host"]
        data["is_captain"] = sid == room["captain"]
        socketio.emit("state", data, to=sid)

def notice(sid, message):
    socketio.emit("notice", message, to=sid)

def private_role(sid, role):
    socketio.emit("role", role, to=sid)

def alive_players(room):
    return [sid for sid, p in room["players"].items() if p["alive"]]

def transfer_doctor(room):
    candidates = [
        p for p in room["players"].values()
        if p["alive"] and p["role"] == "مواطن"
    ]
    if candidates:
        new_doctor = random.choice(candidates)
        new_doctor["role"] = "دكتور"
        private_role(new_doctor["sid"], "دكتور")
        return new_doctor["name"]
    return None

def eliminate(code, sid):
    room = get_room(code)
    if not room or sid not in room["players"]:
        return None

    player = room["players"][sid]
    if not player["alive"]:
        return None

    player["alive"] = False
    old_role = player["role"]
    new_doctor = None

    if old_role == "دكتور":
        new_doctor = transfer_doctor(room)

    return {
        "name": player["name"],
        "role": old_role,
        "new_doctor": new_doctor
    }

def check_winner(code):
    room = get_room(code)
    if not room:
        return True

    alive = alive_players(room)
    mafia = sum(
        room["players"][sid]["role"] == "مافيا"
        for sid in alive
    )
    town = len(alive) - mafia

    if mafia == 0:
        room["phase"] = "ended"
        room["message"] = "🏆 فاز المواطنون!"
    elif mafia >= town:
        room["phase"] = "ended"
        room["message"] = "🏆 فازت المافيا!"

    if room["phase"] == "ended":
        update_room(code)
        return True

    return False

def begin_night(code):
    room = get_room(code)
    if not room:
        return

    room["phase"] = "night"
    room["round"] += 1
    room["message"] = "🌙 حلّ الليل... المافيا والدكتور يختارون"
    room["mafia_target"] = None
    room["doctor_target"] = None
    room["deadline"] = time.time() + 30

    mafia = [
        sid for sid in alive_players(room)
        if room["players"][sid]["role"] == "مافيا"
    ]
    room["captain"] = random.choice(mafia) if mafia else None

    update_room(code)
    socketio.start_background_task(night_timer, code, room["round"])

def night_timer(code, round_number):
    socketio.sleep(30)
    room = get_room(code)
    if room and room["phase"] == "night" and room["round"] == round_number:
        resolve_night(code)

def resolve_night(code):
    room = get_room(code)
    if not room or room["phase"] != "night":
        return

    victim = room["mafia_target"]
    protected = room["doctor_target"]
    message = "🌅 انتهى الليل."

    if victim and victim == protected:
        message = "🛡️ نجح الدكتور في حماية الضحية!"
        notice(victim, "تمت حمايتك!")
    elif victim:
        result = eliminate(code, victim)
        if result:
            message = (
                f"🌅 تم العثور على {result['name']} خارج اللعبة. "
                f"كان دوره: {result['role']}"
            )
            if result["new_doctor"]:
                message += " وانتقل دور الدكتور إلى لاعب جديد."
    else:
        message = "🌅 لم يتم تنفيذ عملية اغتيال."

    room["message"] = message

    if check_winner(code):
        return

    begin_discussion(code)

def begin_discussion(code):
    room = get_room(code)
    if not room:
        return

    room["phase"] = "discussion"
    room["message"] = "☀️ وقت المناقشة! تحدثوا واكتشفوا المافيا."
    room["deadline"] = time.time() + 120
    update_room(code)
    socketio.start_background_task(
        discussion_timer, code, room["round"]
    )

def discussion_timer(code, round_number):
    socketio.sleep(120)
    room = get_room(code)
    if room and room["phase"] == "discussion" and room["round"] == round_number:
        begin_vote(code)

def begin_vote(code):
    room = get_room(code)
    if not room:
        return

    room["phase"] = "vote"
    room["votes"] = {}
    room["message"] = "🗳️ حان وقت التصويت! اختر لاعباً أو تخطَّ."
    room["deadline"] = time.time() + 30
    update_room(code)
    socketio.start_background_task(vote_timer, code, room["round"])

def vote_timer(code, round_number):
    socketio.sleep(30)
    room = get_room(code)
    if room and room["phase"] == "vote" and room["round"] == round_number:
        resolve_vote(code)

def resolve_vote(code):
    room = get_room(code)
    if not room or room["phase"] != "vote":
        return

    counts = {}
    for target in room["votes"].values():
        counts[target] = counts.get(target, 0) + 1

    if not counts:
        room["message"] = "لم يصوت أحد. تم تخطي التصويت."
    else:
        highest = max(counts.values())
        winners = [x for x, n in counts.items() if n == highest]

        if "skip" in winners or len(winners) != 1:
            room["message"] = "انتهى التصويت بالتخطي أو التعادل."
        else:
            target = winners[0]
            if target == "skip":
                room["message"] = "تم تخطي التصويت."
            elif target in room["players"]:
                result = eliminate(code, target)
                if result:
                    room["message"] = (
                        f"تم إخراج {result['name']}. "
                        f"كان دوره: {result['role']}"
                    )
                    if result["new_doctor"]:
                        room["message"] += " وانتقل دور الدكتور إلى لاعب جديد."

    if check_winner(code):
        return

    begin_night(code)

