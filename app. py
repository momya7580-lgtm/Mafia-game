@socketio.on("create")
def create(data):
    name = str(data.get("name", "")).strip()[:18]
    if not name:
        notice(request.sid, "اكتب اسمك أولاً.")
        return

    code = "".join(
        random.choices(string.ascii_uppercase + string.digits, k=6)
    )
    while code in rooms:
        code = "".join(
            random.choices(string.ascii_uppercase + string.digits, k=6)
        )

    rooms[code] = {
        "host": request.sid,
        "players": {},
        "phase": "lobby",
        "round": 0,
        "message": "بانتظار انضمام اللاعبين...",
        "deadline": 0,
        "captain": None,
        "mafia_target": None,
        "doctor_target": None,
        "votes": {}
    }

    add_player(code, request.sid, name)

@socketio.on("join")
def join(data):
    code = str(data.get("code", "")).strip().upper()
    name = str(data.get("name", "")).strip()[:18]
    room = get_room(code)

    if not room:
        notice(request.sid, "كود الغرفة غير صحيح.")
        return
    if room["phase"] != "lobby":
        notice(request.sid, "اللعبة بدأت بالفعل.")
        return
    if len(room["players"]) >= 16:
        notice(request.sid, "الغرفة ممتلئة.")
        return
    if not name:
        notice(request.sid, "اكتب اسمك.")
        return
    if any(p["name"] == name for p in room["players"].values()):
        notice(request.sid, "هذا الاسم مستخدم.")
        return

    add_player(code, request.sid, name)

def add_player(code, sid, name):
    room = get_room(code)
    if any(p["name"] == name for p in room["players"].values()):
        notice(sid, "هذا الاسم مستخدم.")
        return

    join_room(code)
    room["players"][sid] = {
        "sid": sid,
        "name": name,
        "color": random.choice(COLORS),
        "role": None,
        "alive": True
    }
    update_room(code)

@socketio.on("start")
def start():
    room_code = next(
        (c for c, r in rooms.items() if request.sid in r["players"]),
        None
    )
    room = get_room(room_code) if room_code else None

    if not room or request.sid != room["host"]:
        notice(request.sid, "صاحب الغرفة فقط يستطيع بدء اللعبة.")
        return
    if not 10 <= len(room["players"]) <= 16:
        notice(request.sid, "تحتاج الغرفة إلى 10–16 لاعباً.")
        return

    ids = list(room["players"])
    random.shuffle(ids)

    mafia_count = 2 + (len(ids) - 10) // 3
    roles = ["مافيا"] * mafia_count + ["دكتور"]
    roles += ["مواطن"] * (len(ids) - mafia_count - 1)
    random.shuffle(roles)

    for sid, role in zip(ids, roles):
        room["players"][sid]["role"] = role
        room["players"][sid]["alive"] = True
        private_role(sid, role)

    begin_night(room_code)

@socketio.on("action")
def action(data):
    room_code = next(
        (c for c, r in rooms.items() if request.sid in r["players"]),
        None
    )
    room = get_room(room_code) if room_code else None

    if not room or request.sid not in room["players"]:
        return

    player = room["players"][request.sid]
    if not player["alive"]:
        notice(request.sid, "أنت خارج اللعبة.")
        return

    target = str(data.get("target", ""))
    if target != "skip" and (
        target not in room["players"]
        or not room["players"][target]["alive"]
    ):
        return

    if room["phase"] == "night":
        if player["role"] == "مافيا" and request.sid == room["captain"]:
            if target == "skip" or room["players"][target]["role"] == "مافيا":
                notice(request.sid, "اختر لاعباً ليس من المافيا.")
                return
            room["mafia_target"] = target
            notice(request.sid, "تم تسجيل اختيار المافيا.")
        elif player["role"] == "دكتور":
            if target == "skip":
                return
            room["doctor_target"] = target
            notice(request.sid, "تم تسجيل اختيار الحماية.")
        else:
            return

        if room["mafia_target"] and room["doctor_target"]:
            resolve_night(room_code)

    elif room["phase"] == "vote":
        if target != "skip" and target == request.sid:
            notice(request.sid, "لا يمكنك التصويت لنفسك.")
            return

        room["votes"][request.sid] = target
        notice(request.sid, "تم تسجيل صوتك.")

        if len(room["votes"]) >= len(alive_players(room)):
            resolve_vote(room_code)

    update_room(room_code)

